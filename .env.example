# ─────────────────────────────────────────────────────────────────────────────
# RoadPing — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# EXPO_PUBLIC_ prefix is required for Metro to bundle variables into the app.
# Non-prefixed vars are only available in build scripts, NOT in the mobile app.
#
# ⛔ NEVER put the Supabase service-role key here.
#    It must only ever exist in server-side environments (Edge Functions, CI).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Agora voice (server-side ONLY — DO NOT put these in the app) ─────────────
# Real-time push-to-talk audio uses Agora. The mobile app never holds Agora
# credentials; the create-agora-token Edge Function mints short-lived RTC
# tokens. Set these as Supabase secrets (names must NOT start with SUPABASE_):
#
#   supabase secrets set AGORA_APP_ID="your-agora-app-id"
#   supabase secrets set AGORA_APP_CERTIFICATE="your-agora-app-certificate"
#
# ⛔ AGORA_APP_CERTIFICATE is a signing secret — never expose it client-side.

# ── App config (optional overrides) ──────────────────────────────────────────
# Nearby radius in metres (default: 5000 = 5 km)
# EXPO_PUBLIC_NEARBY_RADIUS_M=5000

# Heartbeat interval in milliseconds (default: 12000 = 12 s)
# EXPO_PUBLIC_HEARTBEAT_INTERVAL_MS=12000

# Session expiry in seconds (default: 30 s — must match DB)
# EXPO_PUBLIC_SESSION_EXPIRY_S=30

# ── Screenshot / demo mode (local only — DO NOT enable for production) ──────
# When true:
#   • getNearbyDrivers() returns a curated fixture list instead of calling the
#     backend, so the Drive screen looks populated for App Store screenshots
#     even with no real drivers nearby.
#   • A visible "DEMO DATA" badge appears on the Drive screen.
# Never enable this in a TestFlight or App Store build.
# EXPO_PUBLIC_SCREENSHOT_MODE=false

# ── Agora kill switch (diagnostic only) ──────────────────────────────────────
# When true, the app never loads/requires/initializes the react-native-agora
# native module. Use this to build a binary with Agora fully disabled to prove
# whether the native SDK is causing a post-launch native crash. Room voice
# falls back to speaking-indicator only; launch / sign in / Drive / rooms work.
# EXPO_PUBLIC_DISABLE_AGORA=true
